(f\"NIM :{self.nim}\")\n","    print(f\"Jurusan :{self.jurusan}\")\n","    print(f\"Nilai :{self.nilai}\")\n","    print(f\"Rata-rata :{self.rata_rata():.2f}\") # Corrected method call and formatting\n","    print(f\"Peringkat :{self.peringkat()}\")\n","    print(f\"====================================\")\n","\n","\n","\n","    #Membuat object/instance setelah class didefinisikan\n","mhs1 = mahasiswa(\"Budi\",\"2101001\",\"Informasi\")\n","mhs2 = mahasiswa(\"Sari\",\"2101002\",\"Sistem Informasi\")\n","mhs3 = mahasiswa(\"Harvey\",\"2101003\",\"Ayam Goreng\")\n","\n","#Menggunakan Method\n","mhs1.tambah_nilai(85)\n","mhs1.tambah_nilai(90)\n","mhs1.tambah_nilai(78)\n","mhs1.tampilkan_info()\n","\n","mhs2.tambah_nilai(95)\n","mhs2.tambah_nilai(88)\n","mhs2.tampilkan_info()\n","\n","mhs3.tambah_nilai(100)\n","mhs3.tambah_nilai(97)\n","mhs3.tampilkan_info()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"_0t1H9Ow26tT","executionInfo":{"status":"ok","timestamp":1782881573248,"user_tz":-420,"elapsed":5,"user":{"displayName":"Johhnyy Blaze","userId":"10052513141585591343"}},"outputId":"f1502b0b-b0eb-466e-ac45-ef2dff199092"},"execution_count":63,"outputs":[{"output_type":"stream","name":"stdout","text":["Nilai 85 berhasil ditambahkan.\n","Nilai 90 berhasil ditambahkan.\n","Nilai 78 berhasil ditambahkan.\n","====================================\n","Nama :Budi\n","NIM :2101001\n","Jurusan :Informasi\n","Nilai :[85, 90, 78]\n","Rata-rata :84.33\n","Peringkat :B\n","====================================\n","Nilai 95 berhasil ditambahkan.\n","Nilai 88 berhasil ditambahkan.\n","====================================\n","Nama :Sari\n","NIM :2101002\n","Jurusan :Sistem Informasi\n","Nilai :[95, 88]\n","Rata-rata :91.50\n","Peringkat :A\n","====================================\n","Nilai 100 berhasil ditambahkan.\n","Nilai 97 berhasil ditambahkan.\n","====================================\n","Nama :Harvey\n","NIM :2101003\n","Jurusan :Ayam Goreng\n","Nilai :[100, 97]\